FROM python:3.12-slim

WORKDIR /app

# requirements.txt is at the project root (build context)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the three scripts from a_Monday/
#modules:
COPY modules/ modules/
#agents:
COPY agents/tools/triage.py agents/tools/logistics.py  agents/tools/
#services:
COPY services/triage/ services/triage/


# So `import k_auth` and friends resolve as top-level modules
ENV PYTHONPATH=/app

EXPOSE 8080

CMD ["uvicorn", "services.triage.app:app", "--host", "0.0.0.0", "--port", "8080"]