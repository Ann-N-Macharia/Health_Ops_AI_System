FROM python:3.12-slim

WORKDIR /app

# requirements.txt is at the project root (build context)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the three scripts from a_Monday/
COPY agents/tools/triage.py agents/tools/
COPY services/triage/prompts/ services/triage/prompts/
COPY modules/ modules/


# So `import k_auth` and friends resolve as top-level modules
ENV PYTHONPATH=/app

EXPOSE 8001

CMD ["uvicorn", "agents.tools.triage:app", "--host", "0.0.0.0", "--port", "8001"]