FROM python:3.12-slim

WORKDIR /app

# requirements.txt is at the project root (build context)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the three scripts from a_Monday/
#services:
COPY services/mcp/logistics_mcp.py ./
COPY clinics.json ./

# So `import k_auth` and friends resolve as top-level modules
ENV PYTHONPATH=/app

EXPOSE 8006

CMD ["python", "logistics_mcp.py"]